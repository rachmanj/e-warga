APP_NAME="e-Warga"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=Asia/Makassar
APP_URL=https://rt.pkk-digital.sbs
APP_LOCALE=id
APP_FALLBACK_LOCALE=id

LOG_CHANNEL=stack
LOG_LEVEL=warning

# DB memakai container MySQL milik PKK Digital melalui network Docker bersama.
DB_CONNECTION=mysql
DB_HOST=pkk-digital-mysql-1
DB_PORT=3306
DB_DATABASE=rt_app
DB_USERNAME=rt_app
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_SECURE_COOKIE=true

CACHE_STORE=database
QUEUE_CONNECTION=database

# Sandi admin pertama yang dipakai seeder (dipakai hanya saat pengguna dibuat).
ADMIN_PASSWORD=
